{
  "manifest_version": 3,
  "name": "HANU TKB Preview",
  "version": "1.0.0",
  "description": "Xem trước thời khoá biểu khi chọn môn học trên cổng đào tạo HANU. Made with love by Dai Phong!",
  "permissions": ["storage"],
  "host_permissions": ["*://qldt.hanu.edu.vn/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://qldt.hanu.edu.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "HANU TKB Preview",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
